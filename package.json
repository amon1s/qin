{
  "name": "qin",
  "private": true,
  "version": "1.1.0",
  "description": "A minimal, standalone desktop app for managing and routing LLM API endpoints.",
  "author": "amon1s",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amon1s/qin.git"
  },
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-proxy.mjs",
    "check:renderer": "node scripts/check-renderer.mjs",
    "check:storage": "node scripts/check-storage.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke",
    "dist": "npm run verify && electron-builder"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.qin.desktop",
    "productName": "Qin",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "proxy.cjs",
      "preload.cjs",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "description": "Secure, monochrome LLM API key manager",
      "desktop": {
        "entry": {
          "Name": "Qin",
          "Comment": "Universal LLM API manager and handler",
          "Categories": "Utility;Development;"
        }
      }
    }
  }
}
